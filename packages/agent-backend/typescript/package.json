{
  "name": "agent-backend",
  "version": "0.13.2",
  "description": "A distributed filesystem backend for your AI agent in a single API, just like a database or storage system.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-backend": "./bin/agent-backend.js"
  },
  "files": [
    "dist",
    "bin",
    "native",
    "scripts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:tls-proxy": "tests/integration/tls-proxy/run.sh",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:run": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "filesystem",
    "ai",
    "agents",
    "bash",
    "typescript",
    "tools"
  ],
  "author": "AgentBackend Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepagents-ai/agent-backend.git"
  },
  "bugs": {
    "url": "https://github.com/deepagents-ai/agent-backend/issues"
  },
  "homepage": "https://github.com/deepagents-ai/agent-backend#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/minimatch": "^6.0.0",
    "buffer": "^6.0.3",
    "diff": "^9.0.0",
    "express": "^5.1.0",
    "hono": "^4.13.7",
    "minimatch": "^10.2.6",
    "ssh2": "^1.16.0",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "optionalDependencies": {
    "node-gyp": "^13.0.2"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.49",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
